# Cloudflare Realtime SFU app (camera streams). Leave empty to run without camera streams.
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
# Bearer token the Worker/Durable Object sends to the orchestrator. Empty = no auth (local dev only).
SIM_SHARED_SECRET=
# JSON array of ICE servers for the publisher, e.g. Cloudflare STUN + TURN over TCP/TLS:
# [{"urls":"stun:stun.cloudflare.com:3478"},{"urls":["turn:turn.cloudflare.com:3478?transport=tcp","turns:turn.cloudflare.com:5349?transport=tcp"],"username":"...","credential":"..."}]
SIM_ICE_SERVERS=
