{
  "name": "@noahos/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run models:fetch && pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "d1:migrate:local": "wrangler d1 migrations apply noahos-auth --local --config wrangler.jsonc",
    "d1:migrate": "wrangler d1 migrations apply noahos-auth --remote --config wrangler.jsonc",
    "models:fetch": "node scripts/fetch-menagerie.mjs",
    "models:usdz": "cd ../sim && uv run --group usd python scripts/export_usdz.py --out ../web/public/models/usdz"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@carbon/icons-react": "^11.91.0",
    "@carbon/react": "^1.119.0",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-anthropic": "^1.0.0",
    "@tanstack/ai-react": "^1.0.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass-embedded": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
